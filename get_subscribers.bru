meta {
  name: get_subscribers
  type: http
  seq: 5
}

get {
  url: {{base_url}}/subscribers?s={"memberId":{{memberId}}}&join=subscription&join=saleItem&join=subscription.translations
  body: none
  auth: inherit
}

params:query {
  s: {"memberId":{{memberId}}}
  join: subscription
  join: saleItem
  join: subscription.translations
}

vars:pre-request {
  memberId: 11170
}

settings {
  encodeUrl: true
  timeout: 0
}
