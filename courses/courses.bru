meta {
  name: courses
  type: http
  seq: 8
}

get {
  url: {{base_url}}/courses?limit=50&page=1&s={"id":3}
  body: none
  auth: inherit
}

params:query {
  limit: 50
  page: 1
  s: {"id":3}
  ~s: {"availableFromDate":{"$lte":"{{availableFromDate}}"},"availableTillDate":{"$gte":"{{availableTillDate}}"}}
  ~s: {"availableFromDate":{"$lte":"{{availableFromDate}}"},"availableTillDate":{"$gte":"{{availableTillDate}}"},"productId":{"$in":[{{ids}}]}}
  ~join: tags
  ~join: bookings
  ~sort: productId,ASC
  ~join: linkedSubscriptions
}

vars:pre-request {
  availableFromDate: 2025-10-21T21:59:59.999Z
  availableTillDate: 2025-10-20T22:00:00.000Z
  ids: 32
}

settings {
  encodeUrl: true
  timeout: 0
}
