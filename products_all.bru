meta {
  name: products_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/products?join=tags&join=location&join=documents&join=translations&fields=description,tags,location,documents,startDate,slotMinutes&s={ {{isActive}}, "tags.level":2}
  body: none
  auth: none
}

params:query {
  join: tags
  join: location
  join: documents
  join: translations
  fields: description,tags,location,documents,startDate,slotMinutes
  s: { {{isActive}}, "tags.level":2}
  ~s: { {{isActive}},{{isCourse}},{{tags}} }
  ~s: {"tags.id":39}
  ~s: { "id":139 }
  ~limit: 100
  ~page: 1
  ~join: linkedSubscriptions
  ~s: {"id":{"$in":[3,14,15,10,9,11]}}
  ~s: {"isCourse":true}
}

vars:pre-request {
  isActive: "isActive":1
  isCourse: "isCourse":true
  tags: "tags.id":39
}

settings {
  encodeUrl: true
  timeout: 0
}
