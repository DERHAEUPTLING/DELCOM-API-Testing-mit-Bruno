meta {
  name: products_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/products?s={"tags.id":39}&join=["tags","location","documents","translations"]
  body: none
  auth: none
}

params:query {
  s: {"tags.id":39}
  join: ["tags","location","documents","translations"]
  ~join: tags
  ~join: location
  ~join: documents
  ~join: translations
  ~s: { "id":139 }
  ~s: { {{isActive}},{{isCourse}},{{tags}} }
  ~limit: 100
  ~page: 1
  ~fields: description,tags,location,documents,startDate,slotMinutes
  ~join: linkedSubscriptions
  ~s: {"id":{"$in":[3,14,15,10,9,11]}}
  ~s: {"isCourse":true}
}

vars:pre-request {
  isActive: "isActive":1
  isCourse: "isCourse":true
  tags: "tags.id":39
}

settings {
  encodeUrl: true
  timeout: 0
}
