meta {
  name: products_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/products?join=tags&join=courses&join=documents&join=translations&s={"id":236}&join=linkedSubscriptions&join=linkedSubscriptions.translations
  body: none
  auth: none
}

params:query {
  join: tags
  join: courses
  join: documents
  join: translations
  s: {"id":236}
  join: linkedSubscriptions
  join: linkedSubscriptions.translations
  ~s: {"isCourse":true}
  ~join: products
  ~s: { "description":"Acro Dance" }
  ~fields: description,tags,location,documents,startDate,slotMinutes
  ~s: { {{isActive}},"tags.activeState":true, "allowAsLinkedProduct":true }
  ~s: { {{isActive}}, "$or":[{"allowAsLinkedProduct":true} ,{ "isCourse":true }]}
  ~join: location
  ~s: { {{isActive}},{{isCourse}},{{tags}} }
  ~s: {"tags.id":39}
  ~limit: 100
  ~page: 1
  ~s: {"id":{"$in":[3,14,15,10,9,11]}}
}

vars:pre-request {
  isActive: "isActive":1
  isCourse: "isCourse":true
  tags: "tags.id":39
}

settings {
  encodeUrl: true
  timeout: 0
}
