meta {
  name: products_one
  type: http
  seq: 1
}

get {
  url: {{base_url}}/products?s={"id":{{id}}}&join=location&join=tags&join=translations
  body: none
  auth: none
}

params:query {
  s: {"id":{{id}}}
  join: location
  join: tags
  join: translations
  ~join: documents
  ~join: childProducts
  ~join: childProducts.translations
  ~join: parentBookableProducts
  ~join: parentBookableProducts.translations
  ~join: linkedSubscriptions
  ~join: linkedSubscriptions.translations
  ~join: childProducts.documents
  ~join: surveyParents
}

vars:pre-request {
  id: 120
}

settings {
  encodeUrl: true
  timeout: 0
}
