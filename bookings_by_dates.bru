meta {
  name: bookings_by_dates
  type: http
  seq: 4
}

get {
  url: {{base_url}}/bookings?sort=startDate,ASC&limit=50&page=1&s={"startDate":{"$gte":"{{date}}T00:00:00.000Z"},"endDate":{"$lte":"{{date}}T23:59:59.999Z"}, "linkedProductId":{"$notin":[{{notin}}]}}
  body: none
  auth: none
}

params:query {
  sort: startDate,ASC
  limit: 50
  page: 1
  s: {"startDate":{"$gte":"{{date}}T00:00:00.000Z"},"endDate":{"$lte":"{{date}}T23:59:59.999Z"}, "linkedProductId":{"$notin":[{{notin}}]}}
  ~s: {"linkedProductId":{"$in":[{{linkedProductId}}]}}
}

vars:pre-request {
  page: 1
  date: 2025-11-12
  notin: 0
  status: 1
  linkedProductId: 3
}

settings {
  encodeUrl: true
  timeout: 0
}
