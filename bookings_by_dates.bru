meta {
  name: bookings_by_dates
  type: http
  seq: 5
}

get {
  url: {{base_url}}/bookings?limit=60&page=1&s={"courseId":127}&join=product
  body: none
  auth: none
}

params:query {
  limit: 60
  page: 1
  s: {"courseId":127}
  join: product
  ~join: product.translations
  ~s: {"linkedProductId":{"$in":[{{linkedProductId}}]}}
  ~fields: startDate,endDate
  ~sort: startDate,ASC
  ~s: {"startDate":{"$gte":"{{date}}T00:00:00.000Z"},"endDate":{"$lte":"{{date}}T23:59:59.999Z"}, "linkedProductId":{"$notin":[{{notin}}]}}
}

vars:pre-request {
  page: 1
  date: 2025-11-12
  notin: 0
  status: 1
  linkedProductId: 3
}

settings {
  encodeUrl: true
  timeout: 0
}
