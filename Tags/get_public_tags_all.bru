meta {
  name: get_public_tags_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/public/tags?&limit={{limit}}&page={{page}}&isCourse=true
  body: none
  auth: inherit
}

params:query {
  limit: {{limit}}
  page: {{page}}
  isCourse: true
}

vars:pre-request {
  limit: 10
  page: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
