meta {
  name: public_tags_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/public/tags?s={"activeState":{{state}}}&limit={{limit}}&page={{page}}&isCourse=true
  body: none
  auth: inherit
}

params:query {
  s: {"activeState":{{state}}}
  limit: {{limit}}
  page: {{page}}
  isCourse: true
}

vars:pre-request {
  limit: 10
  page: 1
  state: true
}

settings {
  encodeUrl: true
  timeout: 0
}
