meta {
  name: public_tags_by_level
  type: http
  seq: 9
}

get {
  url: {{base_url}}/public/tags?s={"activeState":{{state}},"level": { "$in": [{{level}}] }}
  body: none
  auth: none
}

params:query {
  s: {"activeState":{{state}},"level": { "$in": [{{level}}] }}
}

vars:pre-request {
  state: true
  level: 1,2
}

settings {
  encodeUrl: true
  timeout: 0
}
