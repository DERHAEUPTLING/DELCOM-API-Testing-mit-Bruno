meta {
  name: documents
  type: http
  seq: 3
}

get {
  url: {{base_url}}/products?limit={{limit}}&page={{page}}&join=documents&fields=documents
  body: none
  auth: none
}

params:query {
  limit: {{limit}}
  page: {{page}}
  join: documents
  fields: documents
}

vars:pre-request {
  limit: 50
  page: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
