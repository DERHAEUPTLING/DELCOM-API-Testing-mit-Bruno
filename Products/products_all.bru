meta {
  name: products_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/products?limit={{limit}}&page={{page}}&join=tags&s={"tags.id":{{tags.id}}}
  body: none
  auth: none
}

params:query {
  limit: {{limit}}
  page: {{page}}
  join: tags
  s: {"tags.id":{{tags.id}}}
  ~isActive: 1
  ~join: location
  ~join: documents
  ~s: {"isCourse":{{isCourse}}}
  ~s: {"id":{"$in":[{{ids_from_bookings}}]}
  ~s: {"isCourse":{{isCourse}}, "id":{"$in":[{{ids_from_bookings}}]}}
}

vars:pre-request {
  limit: 30
  page: 1
  isCourse: true
  search: "isCourse":{{isCourse}}, "id":{"$in":[{{ids_from_bookings}}]}
  search_isCourse: "isCourse":{{isCourse}}
  search_ids: , "id":{"$in":[{{ids_from_bookings}}]}
  search_none: 
  tags.id: 48
}

settings {
  encodeUrl: true
  timeout: 0
}
