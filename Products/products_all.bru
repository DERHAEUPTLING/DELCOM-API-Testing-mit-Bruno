meta {
  name: products_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/products?limit={{limit}}&page={{page}}&s={"id":{"$in":[{{ids_from_bookings}}]}}&join=tags&join=location&join=documents&isActive=1
  body: none
  auth: none
}

params:query {
  limit: {{limit}}
  page: {{page}}
  s: {"id":{"$in":[{{ids_from_bookings}}]}}
  join: tags
  join: location
  join: documents
  isActive: 1
  ~fields: description,tags,location,documents,startDate,slotMinutes
  ~s: {"isActive":{{
  ~s: {"isCourse":{{isCourse}}}
  ~s: {"tags.id":{{tags.id}}}
  ~s: {"isCourse":{{isCourse}}, "id":{"$in":[{{ids_from_bookings}}]}}
}

vars:pre-request {
  limit: 50
  page: 1
  isCourse: true
  search: "isCourse":{{isCourse}}, "id":{"$in":[{{ids_from_bookings}}]}
  search_isCourse: "isCourse":{{isCourse}}
  search_ids: , "id":{"$in":[{{ids_from_bookings}}]}
  tags.id: 39
}

settings {
  encodeUrl: true
  timeout: 0
}
