meta {
  name: products_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/products?s={"isCourse":{{isCourse}}}
  body: none
  auth: none
}

params:query {
  s: {"isCourse":{{isCourse}}}
  ~limit: {{limit}}
  ~page: {{page}}
  ~isActive: 1
  ~join: location
  ~join: documents
}

vars:pre-request {
  limit: 30
  page: 1
  isCourse: true
}

settings {
  encodeUrl: true
  timeout: 0
}
