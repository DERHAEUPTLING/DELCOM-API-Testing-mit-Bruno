meta {
  name: products_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/products?limit={{limit}}&page={{page}}
  body: none
  auth: none
}

params:query {
  limit: {{limit}}
  page: {{page}}
  ~isCourse: true
  ~join: location
}

vars:pre-request {
  limit: 30
  page: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
