meta {
  name: products_all
  type: http
  seq: 2
}

get {
  url: {{base_url}}/products?s={"isCourse":{{isCourse}}, "id":{"$in":[{{ids_from_bookings}}]}}&limit={{limit}}&page={{page}}&isActive=1&join=location&join=documents&join=tags
  body: none
  auth: none
}

params:query {
  s: {"isCourse":{{isCourse}}, "id":{"$in":[{{ids_from_bookings}}]}}
  limit: {{limit}}
  page: {{page}}
  isActive: 1
  join: location
  join: documents
  join: tags
}

vars:pre-request {
  limit: 30
  page: 1
  isCourse: true
}

settings {
  encodeUrl: true
  timeout: 0
}
