meta {
  name: get_products_by_ids
  type: http
  seq: 1
}

get {
  url: {{base_url}}/products?s={"id":{"$in":[{{ids_from_bookings}}]}}&join=tags&join=translations&join=linkedSubscriptions
  body: none
  auth: inherit
}

params:query {
  s: {"id":{"$in":[{{ids_from_bookings}}]}}
  join: tags
  join: translations
  join: linkedSubscriptions
}

settings {
  encodeUrl: true
  timeout: 0
}
