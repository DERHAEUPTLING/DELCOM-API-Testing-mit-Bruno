meta {
  name: products_by_course
  type: http
  seq: 4
}

get {
  url: {{base_url}}/products?&limit={{limit}}&page={{page}}&isCourse=true
  body: none
  auth: inherit
}

params:query {
  limit: {{limit}}
  page: {{page}}
  isCourse: true
}

vars:pre-request {
  limit: 20
  page: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
