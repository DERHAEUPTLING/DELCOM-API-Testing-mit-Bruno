meta {
  name: products_one
  type: http
  seq: 1
}

get {
  url: {{base_url}}/products?s={"id":{{id}}}&join=translations&join=documents&join=childProducts&join=childProducts.translations&join=linkedSubscriptions&join=linkedSubscriptions.translations&join=parentBookableProducts&join=parentBookableProducts.translations&join=childProducts.documents&join=surveyParents&join=location
  body: none
  auth: none
}

params:query {
  s: {"id":{{id}}}
  join: translations
  join: documents
  join: childProducts
  join: childProducts.translations
  join: linkedSubscriptions
  join: linkedSubscriptions.translations
  join: parentBookableProducts
  join: parentBookableProducts.translations
  join: childProducts.documents
  join: surveyParents
  join: location
}

vars:pre-request {
  id: 188
}

settings {
