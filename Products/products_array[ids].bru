meta {
  name: products_array[ids]
  type: http
  seq: 3
}

get {
  url: {{base_url}}/products?s={"id":{"$in":[{{ids_from_bookings}}]}}&join=tags&join=documents
  body: none
  auth: none
}

params:query {
  s: {"id":{"$in":[{{ids_from_bookings}}]}}
  join: tags
  join: documents
}

settings {
  encodeUrl: true
  timeout: 0
}
