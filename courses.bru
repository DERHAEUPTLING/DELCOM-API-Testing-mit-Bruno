meta {
  name: courses
  type: http
  seq: 6
}

get {
  url: {{base_url}}/courses?limit=50&page=1&join=tags&join=bookings&s={"id":127}&join=products
  body: none
  auth: inherit
}

params:query {
  limit: 50
  page: 1
  join: tags
  join: bookings
  s: {"id":127}
  join: products
  ~s: {"availableFromDate":{"$lte":"{{availableFromDate}}"},"availableTillDate":{"$gte":"{{availableTillDate}}"}}
  ~s: {"availableFromDate":{"$lte":"{{availableFromDate}}"},"availableTillDate":{"$gte":"{{availableTillDate}}"},"productId":{"$in":[{{ids}}]}}
  ~sort: productId,ASC
  ~join: subscriptions
}

vars:pre-request {
  availableFromDate: 2025-12-21T21:59:59.999Z
  availableTillDate: 2026-1-20T22:00:00.000Z
  ids: 117
}

settings {
  encodeUrl: true
  timeout: 0
}
